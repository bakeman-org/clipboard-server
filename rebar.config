{erl_opts, [
    debug_info,
    warn_export_all,
    warn_unused_vars,
    warn_unused_import
]}.

{deps, [
    {cowboy, {git, "https://github.com/ninenines/cowboy.git", {branch, "master"}}},
    {jsx, "3.1.0"}

]}.

%% 编译前先执行 make，把 NIF 编出来
{pre_hooks, [
    {compile, "make -C c_src -B"}
]}.

{post_hooks, [
    {clean, "make -C c_src clean -B"}
]}.

{shell, [
    {apps, [clipboard_server]}
]}.